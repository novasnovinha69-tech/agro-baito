# =============================================================================
#  AGRO MUNDO ANIMAL — Variáveis de Ambiente
# =============================================================================
#  Copie este arquivo para `.env.local` e preencha com suas chaves reais.
# Instruções detalhadas (passo a passo) no arquivo README.md → seção "Configuração".
# =============================================================================

# -----------------------------------------------------------------------------
# 1) SUPABASE  →  https://supabase.com  (crie um novo projeto, free tier ok)
# -----------------------------------------------------------------------------
# Project Settings → API:
#   NEXT_PUBLIC_SUPABASE_URL         = "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY    = "anon public" (NÃO use a service_role aqui!)
#   SUPABASE_SERVICE_ROLE_KEY        = "service_role" (SECRETA — só no servidor)
# Project Settings → Database → Connection string (URI):
#   SUPABASE_DB_URL                  = string para rodar migrations/seeds
SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_a_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui
SUPABASE_DB_URL=postgresql://postgres:SUA_SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# Onda a loja roda (para webhooks e links). Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2) MERCADO PAGO (Pix dinâmico)  →  https://www.mercadopago.com.br/developers
# -----------------------------------------------------------------------------
# Suas integrações → sua aplicação → Credenciais:
#   MP_ACCESS_TOKEN   = "Access Token" (de produção OU sandbox p/ testar)
#   MP_PUBLIC_KEY     = "Public Key"
# Em "Webhooks" adicione a URL: https://SEU-DOMINIO/api/webhooks/mercadopago
#   e selecione o evento "Pagamento" (payment). A MP envia x-signature.
MP_ACCESS_TOKEN=APP_USUARIO-xxxxx
MP_PUBLIC_KEY=APP_USUARIO-xxxxx
MP_WEBHOOK_SECRET=defina_um_segredo_opcional_ou_deixe_vazio

# Para testar pagamentos sem dinheiro real:
#   use as credenciais de TESTE (começam com TEST-) e os cartões/Pix de teste da MP.

# -----------------------------------------------------------------------------
# 3) WHATSAPP BUSINESS CLOUD API  →  https://developers.facebook.com
# -----------------------------------------------------------------------------
# 1. Crie um Meta App do tipo "Business" e adicione o produto WhatsApp.
# 2. Em WhatsApp → API Setup:
#      WHATSAPP_PHONE_NUMBER_ID  = "Phone number ID" (número da loja)
#      WHATSAPP_BUSINESS_ID      = "WhatsApp Business Account ID"
# 3. Em Configurações do sistema → Token de acesso (System User token):
#      WHATSAPP_ACCESS_TOKEN
# 4. Aprovação de templates: WhatsApp Manager → Gerenciar modelos de mensagem.
#      Crie os templates listados em lib/whatsapp.ts (confirmação, status...).
# 5. Webhook: configure a URL https://SEU-DOMINIO/api/webhooks/whatsapp
#      e o Verify Token abaixo; assine "messages" e "message_status".
WHATSAPP_ACCESS_TOKEN=EAABxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=107000000000000
WHATSAPP_BUSINESS_ID=1234567890
WHATSAPP_VERIFY_TOKEN=uma_string_secreta_que_voce_inventa
WHATSAPP_API_VERSION=v18.0

# Número da loja no formato internacional (DDI+DDD+numero), só dígitos.
# Agro Mundo Animal (Tabuleiro): (47) 99895-3365
WHATSAPP_LOJA_NUMERO=5547998953365

# Enquanto os templates não são aprovados, use o modo "fallback" (link wa.me).
# Valores: "api" (Cloud API oficial) | "fallback" (link wa.me — sem custo)
WHATSAPP_MODO=fallback

# -----------------------------------------------------------------------------
# 4) SEGURANÇA / APP
# -----------------------------------------------------------------------------
# Frase longa e aleatória usada para assinar/hasher (tokens de pedido, etc.)
APP_SECRET=troque_por_uma_frase_longa_e_aleatoria_de_no_minimo_32_caracteres

# Em produção (Vercel) defina como "production"
NODE_ENV=development
